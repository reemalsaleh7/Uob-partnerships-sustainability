+    string $attributes = '',
+    string $help = ''
+): void {
+    echo '<div class="' . $class . '"><label for="' . $id
+        . '" class="form-label">' . $label . '</label><input id="' . $id
+        . '" name="' . $id . '" type="' . $type
+        . '" class="form-control" ' . $attributes . '>';
